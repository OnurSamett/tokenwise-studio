{
  "name": "tokenwise-studio",
  "version": "0.9.0",
  "description": "Let one agent orchestrate others: Claude Opus delegates to Codex Sol, Claude Haiku/Sonnet or Gemini workers in isolated git worktrees, with a live web UI.",
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "gemini",
    "orchestration",
    "agents",
    "worktree",
    "llm"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "tokenwise-studio": "src/cli.js",
    "tokenwise-studio-mcp": "src/mcp.js",
    "tokenwise-studio-ui": "src/ui.js"
  },
  "files": [
    "src/",
    "ui/",
    "launcher/",
    "assets/logo.png",
    "assets/favicon-64.png",
    "assets/providers/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "ui": "node src/ui.js",
    "mcp": "node src/mcp.js",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  }
}
